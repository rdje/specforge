      },
      {
        "cause_id": "no_canonical_carrier_for_captured_region",
        "definition": "The region is captured and intent-bearing, but the target IR declares no carrier family for its content.",
        "existing_carrier": "CapturedRegionResidualRecord"
      },
      {
        "cause_id": "non_contract_region",
        "definition": "The region is navigational, informational, or advisory and states no implementable obligation.",
        "existing_carrier": null
      },
      {
        "cause_id": "unresolved_grounding",
        "definition": "A typed record exists upstream but its subject could not be grounded in the current document without fabrication.",
        "existing_carrier": null
      }
    ],
    "authority_rule": "a residual is produced from current-document structure and closed grammar only; document, vendor, protocol, and review-label identity are never production selectors",
    "no_fabrication_rule": "a residual records that a captured region did not reach a canonical carrier and never asserts a canonical value in its place"
  },
