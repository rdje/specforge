  "decision": "Count a residual observation only where the review requires a residual, keep every missing canonical key required and fail-closed, and make each required residual a typed, source-linked, replayable record.",
  "authorities": {
    "reviewed_dataset": "crates/specforge/test_data/source_to_intent_vertical/reviewed_dataset.json",
