  },
  "requirement_rule": {
    "observation_unit": "one residual observation per reviewed cell per promoted stage per required residual",
    "promoted_stages": [
      "semantic_ir",
      "intent_ir"
    ],
    "residual_disposition_rule": "a reviewed cell whose expected disposition is residual or non_applicable requires exactly one residual observation at each promoted stage",
    "canonical_disposition_rule": "a reviewed cell whose expected disposition is canonical requires one residual observation at a promoted stage for each reviewed canonical key that stage does not promote, and none when the stage promotes every reviewed key",
    "fail_closed_rule": "a canonical key missing at a promoted stage always adds a required observation; the observation is met only by an exact actionable residual that explains that exact key, so a recall loss can never leave the denominator",
    "duplicate_rule": "a residual whose fact key duplicates a key the same stage promotes canonically never satisfies an observation, and a stage whose residual set contains one is credited with no met observation at that stage; one artifact cannot assert that the same fact both reached and did not reach IntentIR",
    "met_rule": "an observation is met only when the reviewed residual query is exact for the required keys, every matched record carries nonempty provenance, and every required actionability field is populated with a declared value",
    "stage_independence": "SemanticIR and IntentIR observations are counted separately and never substitute for each other"
  },
  "record_grammar": {
    "collection_pointer": "/residuals",
    "identity_fields": [
      "/region_id",
      "/family",
      "/fact_key"
    ],
    "provenance_field": "/source_ids",
    "required_actionability_fields": [
      "/reason",
      "/first_failing_stage",
      "/replay"
    ],
    "first_failing_stage_values": [
      "source_to_evidence_ir",
      "evidence_to_semantic_ir",
      "semantic_to_intent_ir"
    ],
    "typed_causes": [
      {
