#!/usr/bin/env bash
# .githooks/pre-commit — local doctrine gate (E3). Activate once per clone:
#   git config core.hooksPath .githooks
#
# This routes through the GENERAL DOCTRINE ENFORCER (scripts/check_doctrines.sh), which runs every
# registered doctrine check (memory-architecture, knowledge-map, task-acceptance, …) and blocks the
# commit on any breach. See DOCTRINE_ENFORCEMENT.md (the portable standard) for the model.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
source "$ROOT/scripts/project_data_env.sh"
specforge_activate_project_data "$ROOT"

# KNOWLEDGE-MAP is DERIVED — regenerate + stage its complete landing/shard set (including stale-shard
# deletions) BEFORE the driver's check_knowledge_map.sh validates exact membership and content.
"$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
while IFS= read -r output; do
  [ -n "$output" ] && git add -A -- "$output"
done < <("$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" --print-output-paths)

# The single general doctrine enforcer (registry + driver) — runs ALL registered check_*.sh and
# reports per-doctrine PASS/FAIL.
"$ROOT/scripts/check_doctrines.sh"
