# --- Knowledge Map (KM) gate — append these lines to your .githooks/pre-commit ---------
# Regenerate the bounded landing/shard set, stage every output and stale-shard deletion, then
# validate facts + exact projection sync. Regenerate-and-stage makes drift structurally impossible.
# Requires: git config core.hooksPath .githooks   (one-time, per clone)

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
while IFS= read -r output; do
  [ -n "$output" ] && git add -A -- "$output"
done < <("$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" --print-output-paths)
"$ROOT/knowledge-map/scripts/check_knowledge_map.sh"
# ---------------------------------------------------------------------------------------
