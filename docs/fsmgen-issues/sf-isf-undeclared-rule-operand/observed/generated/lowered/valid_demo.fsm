(?fsm:valid_demo

  (+system
    (clock clk)
    (areset rst_n)
  )

  (+size
    (start 1)
    (A 1)
    (B 1)
    (done 1)
    (can_accept 1)
  )

  (tx_idle_0
    (= (can_accept 1))
    (<start
      (-> tx_done_1)
    )
  )

  (tx_done_1
    (<1 (done> 1))
    (-> tx_idle_0)
  )

  (-r_a
    (<- (A> VALID))
  )

  (-r_b
    (<- (B> VALID))
  )

)
