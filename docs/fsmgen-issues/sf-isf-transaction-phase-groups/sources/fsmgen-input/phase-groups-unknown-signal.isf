(actor apb_requester
  (clock clk)
  (reset (rst_n async active_low))
  (interface
    (input start)
    (output PSEL)
    (output PENABLE)
    (output PWRITE)
    (output PADDR (width 8))
    (output PWDATA (width 8))
    (input PREADY)
    (output done))
  (transaction write_transfer
    (on start)
    (phases
      (phase setup (signals PSEL PADDR PWRITE PWDATA NOT_A_PORT))
      (phase access (signals PSEL PENABLE PREADY)))
    (complete done)))
