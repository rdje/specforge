(actor check_demo
  (params
    (ADDR_WIDTH 32)
    (ADDRCHK_WIDTH (/ (+ ADDR_WIDTH 7) 8)))
  (clock clk)
  (reset (rst_n async active_low))
  (interface
    (input start)
    (output ADDR (width ADDR_WIDTH))
    (output ADDRCHK (width ADDRCHK_WIDTH))
    (output done))
  (transaction tx
    (on start)
    (complete done)))
