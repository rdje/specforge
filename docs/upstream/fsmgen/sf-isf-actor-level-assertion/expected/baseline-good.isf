(actor apb_demo
  (clock clk)
  (reset (rst_n async active_low))
  (interface
    (input start)
    (input PSEL)
    (input PENABLE)
    (input PADDR (width 8))
    (output done))
  (transaction tx
    (on start)
    (assert (=> (& PSEL PENABLE) (stable PADDR)) "PADDR must remain stable")
    (complete done)))
